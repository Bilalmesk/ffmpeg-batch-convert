{
  "ffmpegPath": "ffmpeg",
  "ffprobePath": "ffprobe",
  "mode": "remux",
  "recursive": false,
  "extensions": [
    "ts",
    "m2ts",
    "mkv",
    "mov",
    "avi",
    "wmv",
    "flv",
    "webm",
    "m4v",
    "mpg",
    "mpeg"
  ],
  "outputDir": "",
  "format": "mp4",
  "overwrite": "skip",
  "deleteSource": false,
  "dryRun": false,
  "workers": 4,
  "faststart": true,
  "aspect": "",
  "genPts": true,
  "videoCodec": "h264",
  "crf": 22,
  "preset": "fast",
  "audioCodec": "copy",
  "audioBitrate": "192k",
  "audioTracks": "all",
  "audioLanguage": "",
  "subtitleCodec": "auto",
  "trimStart": "",
  "trimEnd": "",
  "logFile": ""
}
